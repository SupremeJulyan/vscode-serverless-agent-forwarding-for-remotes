#!/usr/bin/env bash
# Bundled SSH bridge for WSL — used by the SAFS VS Code extension.
# Password decryption and SSH_ASKPASS credential setup are handled by the
# TypeScript extension side, matching native Linux authentication.
# VPN relay is included for aTrust / VPN scenarios.

set -Eeuo pipefail

die() {
  printf '错误: %s\n' "$*" >&2
  exit 1
}

bridge_performance_now() {
  local value
  if [[ -n "${EPOCHREALTIME:-}" ]]; then
    value="${EPOCHREALTIME/./}"
  else
    value="$(date +%s%6N)"
  fi
  printf -v "$1" '%s' "$value"
}

bridge_performance_log() {
  local label="$1" started_at="$2" finished_at elapsed_us
  bridge_performance_now finished_at
  elapsed_us=$((10#$finished_at - 10#$started_at))
  printf '[性能] %s: %d.%03d ms\n' \
    "$label" "$((elapsed_us / 1000))" "$((elapsed_us % 1000))" >&2
}

# ── Resolve the bundle root ──────────────────────────────────────────────────
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
bundle_root="$(cd -- "$script_dir" && pwd)"

# ── Parse arguments ──────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
用法:
  ssh-bridge -h | --help
  ssh-bridge [-t | --tty] name [远程命令...]
  ssh-bridge probe name                探测目标主机当前密钥并输出 PROBE_OK <base64>

环境变量:
  WSL_VPN_SSH_CONNECTION_REUSE 是否启用 SSH 连接复用 (1/0, 默认 1)
  VPN_TARGET_PORT=22           目标 SSH 端口
EOF
}

force_tty=false
probe_mode=false
case "${1:-}" in
  -t|--tty)
    force_tty=true
    shift
    ;;
  probe)
    probe_mode=true
    shift
    ;;
esac

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
case "$1" in
  -h|--help|help) usage; exit 0 ;;
esac

requested_destination="$1"
shift
remote_args=("$@")

# ── Load helper modules ──────────────────────────────────────────────────────
source "$bundle_root/vpn-relay-pool.sh"
bridge_performance_now bridge_started_at

# ── Config resolution ───────────────────────────────────────────────────────
config_file="${WSL_VPN_SSH_CONFIG:-${HOME:?}/.safs/config.json}"

# flock 仅在中继池使用，且中继池已有 mkdir 锁兜底，不作为基础依赖。
for command in ssh python3; do
  command -v "$command" >/dev/null 2>&1 || die "缺少命令 '$command'"
done

config_values=()
if [[ -r "$config_file" ]]; then
  while IFS= read -r -d '' value; do
    config_values+=("$value")
  done < <(python3 - "$config_file" "$requested_destination" <<'PY'
import json, os, sys

config_path, selected = sys.argv[1:]
try:
    with open(config_path, encoding="utf-8") as f:
        data = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    raise SystemExit(f"配置读取失败: {e}")

entries = data.get("hosts", []) if isinstance(data, dict) else data
if not isinstance(entries, list):
    raise SystemExit("配置顶层必须是数组，或包含 hosts 数组的对象")

for index, item in enumerate(entries):
    if not isinstance(item, dict):
        raise SystemExit(f"第 {index + 1} 项不是对象")
    if str(item.get("name", "")) != selected:
        continue
    missing = [key for key in ("ip", "user") if not item.get(key)]
    if missing:
        raise SystemExit(f"配置 '{selected}' 缺少字段: {', '.join(missing)}")
    values = (
        str(item["ip"]), str(item["user"]), str(item.get("password") or ""),
        os.path.expanduser(str(item.get("private_key_path") or "")),
        str(item.get("port") or 22),
        "true" if item.get("vpn", item.get("atrust", True)) else "false",
    )
    for value in values:
        sys.stdout.buffer.write(value.encode() + b"\0")
    break
PY
  )
fi

private_key_path=""
use_vpn=true
if ((${#config_values[@]})); then
  ((${#config_values[@]} == 6)) || die "配置项读取不完整"
  target_host="${config_values[0]}"
  ssh_user="${config_values[1]}"
  if [[ -n "${config_values[2]}" && -z "${SSH_ASKPASS:-}" ]]; then
    die "配置包含密码，但扩展未提供 SSH_ASKPASS 凭据"
  fi
  private_key_path="${config_values[3]}"
  target_port="${config_values[4]}"
  use_vpn="${config_values[5]}"
  local_destination="$ssh_user@$target_host"
  tunnel_destination="$ssh_user@127.0.0.1"
else
  destination="$requested_destination"
  if [[ "$destination" == *@* ]]; then
    ssh_user="${destination%@*}"
    target_host="${destination##*@}"
    local_destination="$ssh_user@$target_host"
    tunnel_destination="$ssh_user@127.0.0.1"
  else
    target_host="$destination"
    local_destination="$destination"
    tunnel_destination="127.0.0.1"
  fi
  target_port="${VPN_TARGET_PORT:-22}"
fi
target_port="${VPN_TARGET_PORT:-$target_port}"

[[ -n "$target_host" ]] || die "目标主机不能为空"
[[ "$target_port" =~ ^[0-9]+$ ]] \
  && ((target_port >= 1 && target_port <= 65535)) \
  || die "SSH 端口必须是 1-65535 的整数"

# OpenSSH 客户端版本探测（SSH options 与 probe 模式共用）。
ssh_version_line="$(ssh -V 2>&1 || true)"
ssh_major=""
ssh_minor=""
if [[ "$ssh_version_line" =~ OpenSSH_([0-9]+)\.([0-9]+) ]]; then
  ssh_major="${BASH_REMATCH[1]}"
  ssh_minor="${BASH_REMATCH[2]}"
fi

# ── Probe mode（扩展连接前主机密钥校验）────────────────────────────────────
# 输出格式：每行 "PROBE_OK <host> <type> <base64 密钥 blob>"，host 与连接时
# HostKeyAlias 一致（VPN 中继场景为目标主机，端口非 22 时为 [host]:port）；
# 失败输出 PROBE_FAIL 到 stderr 并退出非零。
if [[ "$probe_mode" == true ]]; then
  probe_types=(ssh-ed25519 ecdsa-sha2-nistp256 ecdsa-sha2-nistp384 ecdsa-sha2-nistp521 ssh-rsa)
  if [[ -z "$ssh_major" ]] || (( 10#$ssh_major < 10 )); then
    probe_types+=(ssh-dss)
  fi
  probe_types_joined="$(IFS=,; printf '%s' "${probe_types[*]}")"
  probe_host="$target_host"
  probe_port="$target_port"
  if [[ "$use_vpn" == true ]]; then
    probe_holder="probe-$$"
    read -r probe_relay_pid probe_local_port probe_status < <(
      vpn_relay_acquire "$target_host" "$target_port" "$probe_holder"
    ) || die "Windows TCP 中继启动失败"
    trap 'vpn_relay_release "$target_host" "$target_port" "$probe_holder" || true' EXIT INT TERM
    probe_host=127.0.0.1
    probe_port="$probe_local_port"
  fi
  probe_key_alias="$target_host"
  if [[ "$target_port" != 22 ]]; then
    probe_key_alias="[$target_host]:$target_port"
  fi
  keys="$(ssh-keyscan -T 15 -p "$probe_port" -t "$probe_types_joined" -- "$probe_host" 2>/dev/null || true)"
  if [[ -z "$keys" ]]; then
    printf 'PROBE_FAIL ssh-keyscan 未返回任何主机密钥\n' >&2
    exit 1
  fi
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    set -- $line
    [[ -n "${3:-}" ]] && printf 'PROBE_OK %s %s %s\n' "$probe_key_alias" "$2" "$3"
  done <<<"$keys"
  exit 0
fi

# ── SSH options ──────────────────────────────────────────────────────────────
# OpenSSH 8.8+ rejects ssh-rsa/ssh-dss host keys by default; some servers only
# offer those legacy algorithms (e.g. 10.68.0.1), so re-enable them. The exact
# flags depend on the installed client: PubkeyAcceptedAlgorithms exists only
# since OpenSSH 8.5 (older clients abort with "Bad configuration option"),
# and OpenSSH 10.0 removed DSA entirely, where listing ssh-dss is a syntax
# error.
legacy_host_keys=(ssh-rsa ssh-dss)
if [[ -n "$ssh_major" ]] && (( 10#$ssh_major >= 10 )); then
  legacy_host_keys=(ssh-rsa)
fi
legacy_host_keys_joined="$(IFS=,; printf '%s' "${legacy_host_keys[*]}")"
# 主机密钥策略由扩展按 safs.hostKeyChangedAction 设置注入：
# accept → no + /dev/null（完全静默）；prompt → yes + 扩展独立 known_hosts
# 文件（OpenSSH 原生校验兜底）；reject → yes + 用户真实 known_hosts。
strict_host_key="${WSL_VPN_STRICT_HOST_KEY:-no}"
known_hosts_file="${WSL_VPN_KNOWN_HOSTS_FILE:-}"
ssh_options=(
  -o "StrictHostKeyChecking=${strict_host_key}"
  -o "HostKeyAlgorithms=+${legacy_host_keys_joined}"
)
if [[ -n "$known_hosts_file" ]]; then
  # prompt：扩展已确认并写入密钥记录，OpenSSH 用该文件做最后一道校验。
  ssh_options+=(
    -o "UserKnownHostsFile=$known_hosts_file"
    -o GlobalKnownHostsFile=/dev/null
  )
elif [[ "$strict_host_key" != "yes" ]]; then
  # accept：完全静默——known_hosts 指向 /dev/null，每次连接都视为新主机；
  # LogLevel=ERROR 压掉 "Permanently added …" 提示（真实错误仍正常显示）。
  ssh_options+=(
    -o UserKnownHostsFile=/dev/null
    -o GlobalKnownHostsFile=/dev/null
    -o LogLevel=ERROR
  )
fi
if [[ -z "$ssh_major" ]] \
  || (( 10#$ssh_major > 8 || (10#$ssh_major == 8 && 10#$ssh_minor >= 5) )); then
  ssh_options+=(-o "PubkeyAcceptedAlgorithms=+${legacy_host_keys_joined}")
fi
# 显式 KexAlgorithms 可抑制 OpenSSH 10+ 对旧服务器的 post-quantum 警告。
# 列表按客户端 `ssh -Q kex` 能力过滤（老客户端不认识的算法会直接报错）。
kex_preferred=(sntrup761x25519-sha512 sntrup761x25519-sha512@openssh.com \
  mlkem768x25519-sha256 curve25519-sha256 curve25519-sha256@libssh.org \
  ecdh-sha2-nistp256 ecdh-sha2-nistp384 ecdh-sha2-nistp521 \
  diffie-hellman-group-exchange-sha256 diffie-hellman-group14-sha256 \
  diffie-hellman-group16-sha512 diffie-hellman-group18-sha512 \
  diffie-hellman-group-exchange-sha1 diffie-hellman-group14-sha1 \
  diffie-hellman-group1-sha1)
kex_supported="$(ssh -Q kex 2>/dev/null | tr -d '\r')"
if [[ -n "$kex_supported" ]]; then
  kex_list=()
  for algo in "${kex_preferred[@]}"; do
    if grep -qx "$algo" <<<"$kex_supported"; then
      kex_list+=("$algo")
    fi
  done
  if ((${#kex_list[@]})); then
    kex_joined="$(IFS=,; printf '%s' "${kex_list[*]}")"
    ssh_options+=(-o "KexAlgorithms=${kex_joined}")
  fi
fi
if [[ "${WSL_VPN_SSH_CONNECTION_REUSE:-1}" != 0 ]]; then
  ssh_options+=(
    -o ControlMaster=auto
    -o ControlPersist=10m
    -o "ControlPath=${HOME:?}/.ssh/safs-%C"
  )
fi

if [[ "$force_tty" == true ]] || [[ -n "${SSH_BRIDGE_MOUNT_NAME:-}" && ${#remote_args[@]} -gt 0 ]]; then
  ssh_options+=(-t)
fi
if [[ -n "$private_key_path" ]]; then
  [[ -r "$private_key_path" ]] || die "私钥不可读: $private_key_path"
  ssh_options+=(-i "$private_key_path")
fi

ssh_command=(ssh)

# ── Direct connection (no VPN) ───────────────────────────────────────────────
if [[ "$use_vpn" != true ]]; then
  bridge_performance_log "SSH 连接派发前准备总计" "$bridge_started_at"
  exec "${ssh_command[@]}" "${ssh_options[@]}" -p "$target_port" -- "$local_destination" "${remote_args[@]}"
fi

# ── VPN relay path ───────────────────────────────────────────────────────────
for command in powershell.exe wslpath; do
  command -v "$command" >/dev/null 2>&1 || die "缺少命令 '$command'"
done

relay_holder="ssh-$$"
bridge_performance_now relay_started_at
read -r relay_pid local_port relay_status < <(
  vpn_relay_acquire "$target_host" "$target_port" "$relay_holder"
) || die "Windows TCP 中继启动失败"
bridge_performance_log "VPN 中继获取" "$relay_started_at"
cleanup() {
  vpn_relay_release "$target_host" "$target_port" "$relay_holder" || true
}
trap cleanup EXIT INT TERM

printf 'VPN 中继(%s): 127.0.0.1:%s -> %s:%s (Windows PID %s)\n' \
  "$relay_status" "$local_port" "$target_host" "$target_port" "$relay_pid" >&2

host_key_alias="$target_host"
if [[ "$target_port" != 22 ]]; then
  host_key_alias="[$target_host]:$target_port"
fi

bridge_performance_log "SSH 连接派发前准备总计" "$bridge_started_at"
"${ssh_command[@]}" \
  "${ssh_options[@]}" \
  -p "$local_port" \
  -o "HostKeyAlias=$host_key_alias" \
  -o CheckHostIP=no \
  -- "$tunnel_destination" "${remote_args[@]}"
