{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAFS Configuration",
  "description": "SSH hosts and remote folders used by SAFS.",
  "type": "object",
  "required": ["hosts", "mounts"],
  "properties": {
    "encrypt_passwords": {
      "type": "boolean",
      "default": true,
      "description": "是否由配套 bridge 加密保存密码，建议启用。"
    },
    "hosts": {
      "type": "array",
      "description": "可连接的 SSH 主机。",
      "items": { "$ref": "#/definitions/host" },
      "defaultSnippets": [
        {
          "label": "添加 SSH 主机",
          "body": [{
            "name": "${1:dev}",
            "ip": "${2:10.0.0.2}",
            "user": "${3:alice}",
            "port": 22,
            "vpn": true,
            "private_key_path": "${4:~/.ssh/id_ed25519}"
          }]
        }
      ]
    },
    "mounts": {
      "type": "array",
      "description": "由 Add SSH Config 自动生成的 SFTP 远程目录。",
      "items": { "$ref": "#/definitions/mount" },
      "defaultSnippets": [
        {
          "label": "添加远程目录",
          "body": [{
            "name": "${1:project}",
            "host": "${2:dev}",
            "remote_path": ".",
            "remote_terminal": "open"
          }]
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "host": {
      "type": "object",
      "required": ["name", "ip", "user"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "主机唯一名称，供 mounts.host 引用。" },
        "ip": { "type": "string", "minLength": 1, "description": "服务器 IP 地址或域名。" },
        "user": { "type": "string", "minLength": 1, "description": "SSH 登录用户名。" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22, "description": "SSH 端口。" },
        "vpn": { "type": "boolean", "default": false, "description": "是否通过 VPN 可见的网络连接。" },
        "private_key_path": { "type": "string", "description": "SSH 私钥路径，例如 ~/.ssh/id_ed25519。" },
        "password": { "type": "string", "description": "SSH 密码；使用私钥时无需填写，避免提交到版本库。" }
      },
      "additionalProperties": false
    },
    "mount": {
      "type": "object",
      "required": ["name", "host", "remote_path"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "远程目录的显示名称。" },
        "host": { "type": "string", "minLength": 1, "description": "对应 hosts 中的 name。" },
        "remote_path": { "type": "string", "minLength": 1, "default": ".", "description": "SFTP 远程目录；`.` 表示 SSH 登录目录。" },
        "local_path": {
          "type": "string",
          "deprecated": true,
          "description": "旧版 SSHFS 本地路径；SFTP 版本会忽略此字段。"
        },
        "local_paths": {
          "type": "object",
          "deprecated": true,
          "description": "旧版分平台 SSHFS 路径；SFTP 版本会忽略此字段。"
        },
        "remote_terminal": {
          "type": "string",
          "enum": ["open"],
          "enumDescriptions": ["打开目录后连接终端。"],
          "default": "open",
          "description": "远程终端的打开方式。"
        }
      },
      "additionalProperties": false
    }
  }
}
