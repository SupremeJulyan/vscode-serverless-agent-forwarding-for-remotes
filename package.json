{
  "name": "safs-serverless-agent-forwarding",
  "displayName": "SAFS：Serverless Agent Forwarding for SSH",
  "description": "Serverless Agent Forwarding for SSH: remote SFTP workspaces, SSH execution, and MCP routing without VS Code Server.",
  "icon": "images/icon.png",
  "version": "1.4.3",
  "publisher": "julyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:SupremeJulyan/vscode-serverless-agent-forwarding-for-remotes.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "sftp",
    "remote",
    "agent",
    "mcp",
    "wsl",
    "serverless"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SSH commands and remote file writes require a trusted workspace."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:safs",
    "onStartupFinished",
    "onView:safs.mounts",
    "onCommand:safs.openFolder",
    "onCommand:safs.switchRemoteDirectory",
    "onCommand:safs.openTerminal",
    "onCommand:safs.close",
    "onCommand:safs.status",
    "onCommand:safs.openConfig",
    "onCommand:safs.addSshConfig",
    "onCommand:safs.copyDesktopAgentMcpUrl"
  ],
  "contributes": {
    "commands": [
      {
        "command": "safs.openFolder",
        "title": "SAFS: 打开远程文件夹",
        "icon": "$(remote-explorer)"
      },
      {
        "command": "safs.switchRemoteDirectory",
        "title": "SAFS: 打开远程目录",
        "icon": "$(folder-opened)"
      },
      {
        "command": "safs.openTerminal",
        "title": "SAFS: 打开远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "safs.close",
        "title": "SAFS: 断开 SFTP 连接"
      },
      {
        "command": "safs.status",
        "title": "SAFS: 显示状态"
      },
      {
        "command": "safs.openConfig",
        "title": "SAFS: 打开配置"
      },
      {
        "command": "safs.addSshConfig",
        "title": "SAFS: 添加 SSH 配置",
        "icon": "$(add)"
      },
      {
        "command": "safs.copyDesktopAgentMcpUrl",
        "title": "SAFS: 复制桌面版 Agent MCP 地址"
      },
      {
        "command": "safs.refreshExplorer",
        "title": "刷新远程文件夹",
        "icon": "$(refresh)"
      },
      {
        "command": "safs.openFolderItem",
        "title": "打开远程文件夹",
        "icon": "$(folder-opened)"
      },
      {
        "command": "safs.openTerminalItem",
        "title": "打开远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "safs.closeItem",
        "title": "断开连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "safs.enableAiForwardItem",
        "title": "启用 Agent 转发",
        "icon": "$(sparkle)"
      },
      {
        "command": "safs.disableAiForwardItem",
        "title": "关闭 Agent 转发",
        "icon": "$(circle-slash)"
      },
      {
        "command": "safs.deleteConfigItem",
        "title": "删除配置",
        "icon": "$(trash)"
      },
      {
        "command": "safs.syncToLocal",
        "title": "同步…",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "safs",
          "title": "SAFS",
          "icon": "resources/remote-ssh.svg"
        }
      ]
    },
    "views": {
      "safs": [
        {
          "id": "safs.mounts",
          "name": "远程文件夹"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "safs.mounts",
        "contents": "尚未配置远程文件夹。\n[添加 SSH 配置](command:safs.addSshConfig)\n[打开配置](command:safs.openConfig)",
        "when": "safs.hasNoMounts"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "safs.openFolder"
        },
        {
          "command": "safs.switchRemoteDirectory"
        },
        {
          "command": "safs.openTerminal"
        },
        {
          "command": "safs.close"
        },
        {
          "command": "safs.status"
        },
        {
          "command": "safs.openConfig"
        },
        {
          "command": "safs.addSshConfig"
        },
        {
          "command": "safs.syncToLocal",
          "when": "resourceScheme == safs"
        }
      ],
      "view/title": [
        {
          "command": "safs.addSshConfig",
          "when": "view == safs.mounts",
          "group": "navigation@1"
        },
        {
          "command": "safs.refreshExplorer",
          "when": "view == safs.mounts",
          "group": "navigation@2"
        },
        {
          "command": "safs.openConfig",
          "when": "view == safs.mounts",
          "group": "safs@1"
        },
        {
          "command": "safs.status",
          "when": "view == safs.mounts",
          "group": "safs@2"
        }
      ],
      "view/item/context": [
        {
          "command": "safs.enableAiForwardItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection.*aiDisabled/",
          "group": "inline@1"
        },
        {
          "command": "safs.disableAiForwardItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection.*aiEnabled/",
          "group": "inline@1"
        },
        {
          "command": "safs.openFolderItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "safs.openTerminalItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection/",
          "group": "inline@3"
        },
        {
          "command": "safs.closeItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection\\.connected/",
          "group": "inline@4"
        },
        {
          "command": "safs.enableAiForwardItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection.*aiDisabled/",
          "group": "safs@1"
        },
        {
          "command": "safs.disableAiForwardItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection.*aiEnabled/",
          "group": "safs@1"
        },
        {
          "command": "safs.openFolderItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection/",
          "group": "safs@2"
        },
        {
          "command": "safs.openTerminalItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection/",
          "group": "safs@3"
        },
        {
          "command": "safs.closeItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection\\.connected/",
          "group": "safs@4"
        },
        {
          "command": "safs.deleteConfigItem",
          "when": "view == safs.mounts && viewItem =~ /safs\\.connection/",
          "group": "safs@5"
        }
      ],
      "explorer/context": [
        {
          "command": "safs.syncToLocal",
          "when": "resourceScheme == safs",
          "group": "safs@1"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "safs_runRemoteCommand",
        "displayName": "Run Remote SSH Command",
        "toolReferenceName": "safsRun",
        "canBeReferencedInPrompt": true,
        "icon": "$(terminal)",
        "userDescription": "Run a command in the matching remote SSH directory.",
        "modelDescription": "Runs a command on a configured SSH host. Remote files are not local; use the dedicated remote list, read, write, and search tools for file operations.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "Shell command to execute remotely."
            },
            "mountName": {
              "type": "string",
              "description": "Configured remote folder name."
            },
            "remoteCwd": {
              "type": "string",
              "description": "Optional remote working directory, constrained to the configured remote root."
            }
          },
          "required": [
            "command"
          ]
        }
      },
      {
        "name": "safs_listRemoteFiles",
        "displayName": "List Remote Files",
        "toolReferenceName": "safsList",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Lists a directory directly over SFTP.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      {
        "name": "safs_readRemoteFile",
        "displayName": "Read Remote File",
        "toolReferenceName": "safsRead",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Reads a file directly over SFTP. Use this instead of local filesystem tools.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "offset": {
              "type": "number"
            },
            "length": {
              "type": "number"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "safs_writeRemoteFile",
        "displayName": "Write Remote File",
        "toolReferenceName": "safsWrite",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Creates or replaces a UTF-8 file directly over SFTP.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ]
        }
      },
      {
        "name": "safs_searchRemoteFiles",
        "displayName": "Search Remote Files",
        "toolReferenceName": "safsSearch",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Searches file contents on a configured remote SSH host.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.safs/config.json"
        ],
        "url": "./schemas/config.schema.json"
      }
    ],
    "configuration": {
      "title": "SAFS",
      "properties": {
        "safs.configPath": {
          "type": "string",
          "default": "~/.safs/config.json",
          "description": "Configuration file path. Defaults to ~/.safs/config.json on all platforms."
        },
        "safs.sshClientIdent": {
          "type": "string",
          "default": "OpenSSH_9.6",
          "markdownDescription": "SSH 客户端标识字符串（`SSH-2.0-` 之后的部分）。部分 NSG/网关按客户端指纹白名单放行，默认的 `ssh2js` 标识可能被拒绝（表现为 `Unable to start subsystem: sftp` / `Unable to request a pseudo-terminal`）。默认伪装为 `OpenSSH_9.6`；如仍被拒可尝试 `PuTTY_Release_0.78`（MobaXterm 同款）等常见客户端标识。"
        },
        "safs.reuseSshConnection": {
          "type": "boolean",
          "default": true,
          "description": "Reuse OpenSSH connections between remote terminals and command executions."
        },
        "safs.hostKeyChangedAction": {
          "type": "string",
          "enum": [
            "prompt",
            "reject",
            "accept"
          ],
          "default": "accept",
          "markdownDescription": "SSH 主机密钥发生变化时的处理方式（例如负载均衡 VIP 每次连接到不同后端、各后端密钥不同的场景）：`accept`（默认）静默接受并更新已存密钥（MobaXterm 风格）；`prompt` 弹窗提示新旧密钥并允许接受新密钥后继续连接；`reject` 直接拒绝连接（旧行为）。该设置作用于所有传输路径：内置 ssh2 通道（Windows 终端、SFTP 文件系统与命令执行）的 TOFU 校验，以及系统 ssh 路径的 StrictHostKeyChecking（accept→no、prompt→accept-new、reject→yes）。"
        },
        "safs.sftp.cacheTtl": {
          "type": "number",
          "minimum": 0,
          "default": 5,
          "description": "SFTP metadata and directory cache lifetime in seconds."
        },
        "safs.sftp.watchInterval": {
          "type": "number",
          "minimum": 1,
          "default": 5,
          "description": "Remote file polling interval in seconds."
        },
        "safs.sftp.idleConnectionTtl": {
          "type": "number",
          "minimum": 0,
          "default": 600,
          "description": "Idle SFTP connection lifetime in seconds before the pool recycles it (0 disables recycling)."
        },
        "safs.agentMcpPort": {
          "type": "number",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Dynamic loopback-only MCP backend port for each remote VS Code window. Use 0 (recommended) to avoid multi-window collisions."
        },
        "safs.agentHttpRouterPort": {
          "type": "number",
          "minimum": 1024,
          "maximum": 65535,
          "default": 9848,
          "scope": "machine",
          "description": "Stable loopback-only Streamable HTTP MCP router port registered with Agents. All VS Code windows must use the same value."
        },
        "safs.agentMcpTimeoutMs": {
          "type": "number",
          "minimum": 0,
          "default": 120000,
          "description": "Timeout for Agent MCP remote command/search execution (milliseconds). 0 disables the timeout. On expiry the command is aborted and an error is returned, so a hung Agent cannot leave remote commands running in the background forever."
        },
        "safs.agentForwardingAgents": {
          "type": "array",
          "default": [
            "codex",
            "claude",
            "pi",
            "dsh"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "suggestions": [
              "codex",
              "claude",
              "pi",
              "dsh"
            ]
          },
          "markdownDescription": "Agent CLI 名称列表，启用 Serverless Remote MCP 转发。扩展按名称从 `PATH` 查找支持 `mcp` 指令的 CLI，找不到时再从对应 VS Code Agent 扩展安装路径查找内置 CLI；**不支持的 MCP 的 CLI 会被跳过并提示。** 常见值：`codex`（OpenAI Codex）、`claude`（Anthropic Claude Code）、`pi`（pi coding agent）、`dsh`（DeepSeek Harness，写入 `$DSH_HOME/cordis.patch.yml` 注册 `@deepseek-ai/dsh-mcp-client`，HMR 热加载）等。"
        },
        "safs.highRiskCommandPatterns": {
          "type": "array",
          "default": [
            "rm\\s+-(?:[a-z]*rf[a-z]*|[a-z]*fr[a-z]*)\\b",
            "(?<![\\w./-])mkfs(?:\\.\\w+)?(?:\\s|$)",
            "(?<![\\w./-])(?:fdisk|sfdisk|parted|wipefs|shred)\\b",
            "dd\\s+(?:(?!of=/dev/null\\b).)*\\bof=/dev/",
            "(?<![\\w./-])(?:shutdown|reboot|halt|poweroff)\\b",
            "systemctl\\s+(?:poweroff|reboot|halt)\\b",
            "chmod\\s+-R\\s+777\\s+/",
            "chown\\s+-R\\s+(?:root|0)\\s+/",
            "\\b(?:curl|wget)\\b.*\\|\\s*(?:sudo\\s+)?(?:sh|bash|zsh)\\b",
            "(?<![\\w./-])diskpart\\b",
            "format\\s+[a-z]:",
            "(?<![\\w./-])sudo\\b",
            "(?<![\\w./-])su\\b",
            "(?<![\\w./-])(?:doas|pkexec|gksu|gksudo|kdesu|runas)\\b",
            "chmod\\s+(?:[ugoa]*\\+s\\b|[246][0-7]{3}\\b)",
            "\\b(?:setuid|setgid)\\b",
            "(?<![\\w./-])(?:visudo|sudoers)\\b",
            "(?<![\\w./-])(?:passwd|useradd|usermod|userdel|groupadd|groupmod|groupdel)\\b",
            "(?<![\\w./-])net\\s+(?:user|localgroup)\\b",
            "chattr\\s+[-+][^ ]*i\\b"
          ],
          "items": {
            "type": "string"
          },
          "description": "Regular expressions matched against remote commands requested by Agents. A matching command is denied, or requires confirmation when safs.highRiskCommandAction is \"confirm\". Set to [] to disable interception. Matching ignores quoted strings so search terms are not false positives."
        },
        "safs.highRiskCommandAction": {
          "type": "string",
          "enum": [
            "deny",
            "confirm"
          ],
          "default": "deny",
          "description": "How to handle remote commands matching safs.highRiskCommandPatterns: \"deny\" rejects them without running; \"confirm\" asks the user before each execution."
        },
        "safs.terminalFollowsActiveFile": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "切换/打开远程文件时，实时把远程终端 `cd` 到文件所在目录（默认 `false`）。无论该设置如何，**打开远程终端**和**重开远程窗口**都会跟随当前打开的远程文件目录。"
        }
      }
    },
    "keybindings": [
      {
        "key": "tab",
        "command": "safs.completeRemoteDirectory",
        "when": "safs.directoryPickerVisible"
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "npm run check-types && tsx --test test/*.test.ts",
    "vsix": "npx @vscode/vsce package --no-dependencies --baseContentUrl https://github.com/SupremeJulyan/vscode-serverless-agent-forwarding-for-remotes/blob/main --baseImagesUrl https://raw.githubusercontent.com/SupremeJulyan/vscode-serverless-agent-forwarding-for-remotes/main"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  }
}
