{
  "name": "vscode-serverless-remote-ssh",
  "displayName": "Serverless Remote SSH",
  "description": "Browse and edit remote files over SFTP and open SSH terminals without installing VS Code Server.",
  "icon": "images/icon.png",
  "version": "2.0.0",
  "publisher": "julyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SupremeJulyan/vscode-serverless-remote-ssh.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "sftp",
    "remote",
    "wsl",
    "serverless"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SSH commands and remote file writes require a trusted workspace."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:serverless-sftp",
    "onStartupFinished",
    "onView:serverlessRemote.mounts",
    "onCommand:serverlessRemote.openFolder",
    "onCommand:serverlessRemote.openTerminal",
    "onCommand:serverlessRemote.close",
    "onCommand:serverlessRemote.status",
    "onCommand:serverlessRemote.openConfig",
    "onCommand:serverlessRemote.addSshConfig"
  ],
  "contributes": {
    "commands": [
      {
        "command": "serverlessRemote.openFolder",
        "title": "Serverless Remote SSH: 打开远程文件夹",
        "icon": "$(remote-explorer)"
      },
      {
        "command": "serverlessRemote.openTerminal",
        "title": "Serverless Remote SSH: 打开远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "serverlessRemote.close",
        "title": "Serverless Remote SSH: 断开 SFTP 连接"
      },
      {
        "command": "serverlessRemote.status",
        "title": "Serverless Remote SSH: 显示状态"
      },
      {
        "command": "serverlessRemote.openConfig",
        "title": "Serverless Remote SSH: 打开配置"
      },
      {
        "command": "serverlessRemote.addSshConfig",
        "title": "Serverless Remote SSH: 添加 SSH 配置",
        "icon": "$(add)"
      },
      {
        "command": "serverlessRemote.refreshExplorer",
        "title": "刷新远程文件夹",
        "icon": "$(refresh)"
      },
      {
        "command": "serverlessRemote.openFolderItem",
        "title": "打开远程文件夹",
        "icon": "$(folder-opened)"
      },
      {
        "command": "serverlessRemote.openTerminalItem",
        "title": "打开远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "serverlessRemote.closeItem",
        "title": "断开连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "serverlessRemote.toggleAiForwardItem",
        "title": "打开/关闭 AI 转发",
        "icon": "$(sparkle)"
      },
      {
        "command": "serverlessRemote.deleteConfigItem",
        "title": "删除配置",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serverlessRemote",
          "title": "Serverless Remote SSH",
          "icon": "resources/remote-ssh.svg"
        }
      ]
    },
    "views": {
      "serverlessRemote": [
        {
          "id": "serverlessRemote.mounts",
          "name": "远程文件夹"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "serverlessRemote.mounts",
        "contents": "尚未配置远程文件夹。\n[添加 SSH 配置](command:serverlessRemote.addSshConfig)\n[打开配置](command:serverlessRemote.openConfig)",
        "when": "serverlessRemote.hasNoMounts"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "serverlessRemote.openFolder"
        },
        {
          "command": "serverlessRemote.openTerminal"
        },
        {
          "command": "serverlessRemote.close"
        },
        {
          "command": "serverlessRemote.status"
        },
        {
          "command": "serverlessRemote.openConfig"
        },
        {
          "command": "serverlessRemote.addSshConfig"
        }
      ],
      "view/title": [
        {
          "command": "serverlessRemote.addSshConfig",
          "when": "view == serverlessRemote.mounts",
          "group": "navigation@1"
        },
        {
          "command": "serverlessRemote.refreshExplorer",
          "when": "view == serverlessRemote.mounts",
          "group": "navigation@2"
        },
        {
          "command": "serverlessRemote.openConfig",
          "when": "view == serverlessRemote.mounts",
          "group": "serverlessRemote@1"
        },
        {
          "command": "serverlessRemote.status",
          "when": "view == serverlessRemote.mounts",
          "group": "serverlessRemote@2"
        }
      ],
      "view/item/context": [
        {
          "command": "serverlessRemote.toggleAiForwardItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "inline@1"
        },
        {
          "command": "serverlessRemote.openFolderItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "serverlessRemote.openTerminalItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "inline@3"
        },
        {
          "command": "serverlessRemote.closeItem",
          "when": "view == serverlessRemote.mounts && viewItem == serverlessRemote.connection.connected",
          "group": "inline@4"
        },
        {
          "command": "serverlessRemote.toggleAiForwardItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "serverlessRemote@1"
        },
        {
          "command": "serverlessRemote.openFolderItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "serverlessRemote@2"
        },
        {
          "command": "serverlessRemote.openTerminalItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "serverlessRemote@3"
        },
        {
          "command": "serverlessRemote.closeItem",
          "when": "view == serverlessRemote.mounts && viewItem == serverlessRemote.connection.connected",
          "group": "serverlessRemote@4"
        },
        {
          "command": "serverlessRemote.deleteConfigItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.connection/",
          "group": "serverlessRemote@5"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "serverlessRemote_runRemoteCommand",
        "displayName": "Run Remote SSH Command",
        "toolReferenceName": "serverlessRemoteRun",
        "canBeReferencedInPrompt": true,
        "icon": "$(terminal)",
        "userDescription": "Run a command in the matching remote SSH directory.",
        "modelDescription": "Runs a command on a configured SSH host. Remote files are not local; use the dedicated remote list, read, write, and search tools for file operations.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "Shell command to execute remotely."
            },
            "mountName": {
              "type": "string",
              "description": "Configured remote folder name."
            },
            "remoteCwd": {
              "type": "string",
              "description": "Optional remote working directory, constrained to the configured remote root."
            }
          },
          "required": [
            "command",
            "mountName"
          ]
        }
      },
      {
        "name": "serverlessRemote_listRemoteFiles",
        "displayName": "List Remote Files",
        "toolReferenceName": "serverlessRemoteList",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Lists a directory directly over SFTP.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": { "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["mountName"]
        }
      },
      {
        "name": "serverlessRemote_readRemoteFile",
        "displayName": "Read Remote File",
        "toolReferenceName": "serverlessRemoteRead",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Reads a file directly over SFTP. Use this instead of local filesystem tools.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": { "type": "string" },
            "path": { "type": "string" },
            "offset": { "type": "number" },
            "length": { "type": "number" }
          },
          "required": ["mountName", "path"]
        }
      },
      {
        "name": "serverlessRemote_writeRemoteFile",
        "displayName": "Write Remote File",
        "toolReferenceName": "serverlessRemoteWrite",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Creates or replaces a UTF-8 file directly over SFTP.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": { "type": "string" },
            "path": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["mountName", "path", "content"]
        }
      },
      {
        "name": "serverlessRemote_searchRemoteFiles",
        "displayName": "Search Remote Files",
        "toolReferenceName": "serverlessRemoteSearch",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Searches file contents on a configured remote SSH host.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mountName": { "type": "string" },
            "query": { "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["mountName", "query"]
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/serverless-remote-ssh/config.json",
          "**/.wsl-vpn-ssh/config.json"
        ],
        "url": "./schemas/config.schema.json"
      }
    ],
    "configuration": {
      "title": "Serverless Remote SSH",
      "properties": {
        "serverlessRemote.configPath": {
          "type": "string",
          "default": "~/serverless-remote-ssh/config.json",
          "description": "Native default: ~/serverless-remote-ssh/config.json. WSL default: ~/.wsl-vpn-ssh/config.json. An explicit value overrides the platform default."
        },
        "serverlessRemote.reuseSshConnection": {
          "type": "boolean",
          "default": true,
          "description": "Reuse OpenSSH connections between remote terminals and command executions."
        },
        "serverlessRemote.sftp.cacheTtl": {
          "type": "number",
          "minimum": 0,
          "default": 5,
          "description": "SFTP metadata and directory cache lifetime in seconds."
        },
        "serverlessRemote.sftp.watchInterval": {
          "type": "number",
          "minimum": 1,
          "default": 5,
          "description": "Remote file polling interval in seconds."
        },
        "serverlessRemote.agentMcpPort": {
          "type": "number",
          "minimum": 1024,
          "maximum": 65535,
          "default": 9848,
          "description": "Loopback-only Streamable HTTP MCP port used by Codex, Claude Code, and other agents."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "npm run check-types && tsx --test test/*.test.ts",
    "vsix": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  }
}
