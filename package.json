{
  "name": "vscode-serverless-remote-ssh",
  "displayName": "Serverless Remote SSH",
  "description": "Edit SSHFS-mounted remote files and open SSH terminals without installing VS Code Server on the target.",
  "version": "0.8.2",
  "publisher": "julyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SupremeJulyan/vscode-serverless-remote-ssh.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "keywords": ["ssh", "sshfs", "remote", "wsl", "serverless"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:serverlessRemote.openFolder",
    "onCommand:serverlessRemote.openTerminal",
    "onCommand:serverlessRemote.close",
    "onCommand:serverlessRemote.status",
    "onCommand:serverlessRemote.openConfig",
    "onCommand:serverlessRemote.addSshConfig",
    "onCommand:serverlessRemote.installDependenciesTips"
  ],
  "contributes": {
    "commands": [
      { "command": "serverlessRemote.openFolder", "title": "Serverless Remote SSH: Open Remote Folder", "icon": "$(remote-explorer)" },
      { "command": "serverlessRemote.openTerminal", "title": "Serverless Remote SSH: Open Remote Terminal", "icon": "$(terminal)" },
      { "command": "serverlessRemote.close", "title": "Serverless Remote SSH: Close" },
      { "command": "serverlessRemote.status", "title": "Serverless Remote SSH: Show Status" },
      { "command": "serverlessRemote.openConfig", "title": "Serverless Remote SSH: Open Config" },
      { "command": "serverlessRemote.addSshConfig", "title": "Serverless Remote SSH: Add SSH Config" },
      { "command": "serverlessRemote.installDependenciesTips", "title": "Serverless Remote SSH: Install Dependencies Tips" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "serverlessRemote.openFolder" },
        { "command": "serverlessRemote.openTerminal" },
        { "command": "serverlessRemote.close" },
        { "command": "serverlessRemote.status" },
        { "command": "serverlessRemote.openConfig" },
        { "command": "serverlessRemote.addSshConfig" },
        { "command": "serverlessRemote.installDependenciesTips" }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/serverless-remote-ssh/config.json",
          "**/.wsl-vpn-ssh/config.json"
        ],
        "url": "./schemas/config.schema.json"
      }
    ],
    "configuration": {
      "title": "Serverless Remote SSH",
      "properties": {
        "serverlessRemote.configPath": {
          "type": "string",
          "default": "~/serverless-remote-ssh/config.json",
          "description": "Native default: ~/serverless-remote-ssh/config.json. WSL default: ~/.wsl-vpn-ssh/config.json. An explicit value overrides the platform default."
        },
        "serverlessRemote.mountTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Seconds to wait for an SSHFS mount before reporting a timeout."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "npm run check-types && tsx --test test/*.test.ts",
    "vsix": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
