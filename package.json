{
  "name": "vscode-serverless-remote-ssh",
  "displayName": "Serverless Remote SSH",
  "description": "Edit SSHFS-mounted remote files and open SSH terminals without installing VS Code Server on the target.",
  "icon": "images/icon.png",
  "version": "0.9.7",
  "publisher": "julyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SupremeJulyan/vscode-serverless-remote-ssh.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "sshfs",
    "remote",
    "wsl",
    "serverless"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onView:serverlessRemote.mounts",
    "onCommand:serverlessRemote.openFolder",
    "onCommand:serverlessRemote.openTerminal",
    "onCommand:serverlessRemote.close",
    "onCommand:serverlessRemote.status",
    "onCommand:serverlessRemote.openConfig",
    "onCommand:serverlessRemote.addSshConfig",
    "onCommand:serverlessRemote.installDependenciesTips"
  ],
  "contributes": {
    "commands": [
      {
        "command": "serverlessRemote.openFolder",
        "title": "Serverless Remote SSH: 打开远程文件夹",
        "icon": "$(remote-explorer)"
      },
      {
        "command": "serverlessRemote.openTerminal",
        "title": "Serverless Remote SSH: 打开远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "serverlessRemote.close",
        "title": "Serverless Remote SSH: 关闭连接"
      },
      {
        "command": "serverlessRemote.status",
        "title": "Serverless Remote SSH: 显示状态"
      },
      {
        "command": "serverlessRemote.openConfig",
        "title": "Serverless Remote SSH: 打开配置"
      },
      {
        "command": "serverlessRemote.addSshConfig",
        "title": "Serverless Remote SSH: 添加 SSH 配置",
        "icon": "$(add)"
      },
      {
        "command": "serverlessRemote.installDependenciesTips",
        "title": "Serverless Remote SSH: 查看依赖安装说明"
      },
      {
        "command": "serverlessRemote.refreshExplorer",
        "title": "刷新远程文件夹",
        "icon": "$(refresh)"
      },
      {
        "command": "serverlessRemote.openFolderItem",
        "title": "打开远程文件夹",
        "icon": "$(folder-opened)"
      },
      {
        "command": "serverlessRemote.openTerminalItem",
        "title": "打开远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "serverlessRemote.closeItem",
        "title": "断开连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "serverlessRemote.deleteConfigItem",
        "title": "删除配置",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serverlessRemote",
          "title": "Serverless Remote SSH",
          "icon": "resources/remote-ssh.svg"
        }
      ]
    },
    "views": {
      "serverlessRemote": [
        {
          "id": "serverlessRemote.mounts",
          "name": "远程文件夹"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "serverlessRemote.mounts",
        "contents": "尚未配置远程文件夹。\n[添加 SSH 配置](command:serverlessRemote.addSshConfig)\n[打开配置](command:serverlessRemote.openConfig)",
        "when": "serverlessRemote.hasNoMounts"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "serverlessRemote.openFolder"
        },
        {
          "command": "serverlessRemote.openTerminal"
        },
        {
          "command": "serverlessRemote.close"
        },
        {
          "command": "serverlessRemote.status"
        },
        {
          "command": "serverlessRemote.openConfig"
        },
        {
          "command": "serverlessRemote.addSshConfig"
        },
        {
          "command": "serverlessRemote.installDependenciesTips"
        }
      ],
      "view/title": [
        {
          "command": "serverlessRemote.addSshConfig",
          "when": "view == serverlessRemote.mounts",
          "group": "navigation@1"
        },
        {
          "command": "serverlessRemote.refreshExplorer",
          "when": "view == serverlessRemote.mounts",
          "group": "navigation@2"
        },
        {
          "command": "serverlessRemote.openConfig",
          "when": "view == serverlessRemote.mounts",
          "group": "serverlessRemote@1"
        },
        {
          "command": "serverlessRemote.status",
          "when": "view == serverlessRemote.mounts",
          "group": "serverlessRemote@2"
        },
        {
          "command": "serverlessRemote.installDependenciesTips",
          "when": "view == serverlessRemote.mounts",
          "group": "serverlessRemote@3"
        }
      ],
      "view/item/context": [
        {
          "command": "serverlessRemote.openFolderItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.mount/",
          "group": "inline@1"
        },
        {
          "command": "serverlessRemote.openTerminalItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.mount/",
          "group": "inline@2"
        },
        {
          "command": "serverlessRemote.closeItem",
          "when": "view == serverlessRemote.mounts && viewItem == serverlessRemote.mount.mounted",
          "group": "inline@3"
        },
        {
          "command": "serverlessRemote.openFolderItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.mount/",
          "group": "serverlessRemote@1"
        },
        {
          "command": "serverlessRemote.openTerminalItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.mount/",
          "group": "serverlessRemote@2"
        },
        {
          "command": "serverlessRemote.closeItem",
          "when": "view == serverlessRemote.mounts && viewItem == serverlessRemote.mount.mounted",
          "group": "serverlessRemote@3"
        },
        {
          "command": "serverlessRemote.deleteConfigItem",
          "when": "view == serverlessRemote.mounts && viewItem =~ /serverlessRemote\\.mount/",
          "group": "serverlessRemote@4"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/serverless-remote-ssh/config.json",
          "**/.wsl-vpn-ssh/config.json"
        ],
        "url": "./schemas/config.schema.json"
      }
    ],
    "configuration": {
      "title": "Serverless Remote SSH",
      "properties": {
        "serverlessRemote.configPath": {
          "type": "string",
          "default": "~/serverless-remote-ssh/config.json",
          "description": "Native default: ~/serverless-remote-ssh/config.json. WSL default: ~/.wsl-vpn-ssh/config.json. An explicit value overrides the platform default."
        },
        "serverlessRemote.reuseSshConnection": {
          "type": "boolean",
          "default": true,
          "description": "Reuse one OpenSSH connection between SSHFS and terminals on Linux, macOS, and WSL."
        },
        "serverlessRemote.sshfsCacheProfile": {
          "type": "string",
          "enum": [
            "fresh",
            "balanced",
            "fast"
          ],
          "enumDescriptions": [
            "Disable SSHFS caches where possible so remote changes appear immediately.",
            "Cache file and directory metadata for a few seconds.",
            "Use longer metadata and kernel caches for speed; external remote changes may appear later."
          ],
          "default": "balanced",
          "description": "Native Linux/macOS SSHFS cache policy."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "vscode:uninstall": "node ./dist/lifecycle.js",
    "test": "npm run check-types && tsx --test test/*.test.ts",
    "vsix": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
